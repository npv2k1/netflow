# GEMINI_API_KEY: OPTIONAL. If provided, enables the AI diagram generator & analyzer (server-side only).
# If omitted or left empty, the app runs normally with all AI UI hidden.
# On Vercel: Optionally add this in Project Settings -> Environment Variables.
GEMINI_API_KEY=""

# NEXT_PUBLIC_SITE_URL: OPTIONAL. Public canonical domain when deployed on Vercel (e.g. https://netflow-studio.vercel.app).
# If omitted, Vercel's built-in VERCEL_URL is used automatically.
NEXT_PUBLIC_SITE_URL=""

# APP_URL: OPTIONAL. Base URL when hosted outside Vercel (auto-injected in AI Studio).
APP_URL=""
